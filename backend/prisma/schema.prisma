generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. VAI TRÒ & PHÂN QUYỀN (RBAC)
// ----------------------------------------------------

model VaiTro {
  id          String             @id @default(uuid())
  maVaiTro    String             @unique @map("ma_vai_tro") // ADMIN, DIRECTOR, TEAM_LEAD, SALES_REP, MARKETING, CUST_SUCCESS, ACCOUNTANT
  tenVaiTro   String             @map("ten_vai_tro")
  moTa        String?            @map("mo_ta")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  nguoiDung   NguoiDungVaiTro[]
  quyenHan    VaiTroQuyenHan[]

  @@map("vai_tro")
}

model QuyenHan {
  id        String           @id @default(uuid())
  maQuyen   String           @unique @map("ma_quyen")
  tenQuyen  String           @map("ten_quyen")
  module    String           @map("module")
  moTa      String?          @map("mo_ta")
  createdAt DateTime         @default(now()) @map("created_at")

  vaiTro    VaiTroQuyenHan[]

  @@map("quyen_han")
}

model VaiTroQuyenHan {
  vaiTroId   String   @map("vai_tro_id")
  quyenHanId String   @map("quyen_han_id")

  vaiTro     VaiTro   @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)
  quyenHan   QuyenHan @relation(fields: [quyenHanId], references: [id], onDelete: Cascade)

  @@id([vaiTroId, quyenHanId])
  @@map("vai_tro_quyen_han")
}

// ----------------------------------------------------
// 2. KHU VỰC & NHÓM KINH DOANH (CƠ CẤU TỔ CHỨC)
// ----------------------------------------------------

model KhuVuc {
  id        String           @id @default(uuid())
  maKhuVuc  String           @unique @map("ma_khu_vuc")
  tenKhuVuc String           @map("ten_khu_vuc")
  moTa      String?          @map("mo_ta")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  nhomKinhDoanh NhomKinhDoanh[]
  leads         Lead[]

  @@map("khu_vuc")
}

model NhomKinhDoanh {
  id           String          @id @default(uuid())
  maNhom       String          @unique @map("ma_nhom")
  tenNhom      String          @map("ten_nhom")
  nhomChaId    String?         @map("nhom_cha_id")
  khuVucId     String?         @map("khu_vuc_id")
  truongNhomId String?         @map("truong_nhom_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  nhomCha      NhomKinhDoanh?  @relation("NhomCay", fields: [nhomChaId], references: [id], onDelete: SetNull)
  nhomCon      NhomKinhDoanh[] @relation("NhomCay")
  khuVuc       KhuVuc?         @relation(fields: [khuVucId], references: [id], onDelete: SetNull)
  truongNhom   NguoiDung?      @relation("TruongNhom", fields: [truongNhomId], references: [id], onDelete: SetNull)
  thanhVien    NguoiDung[]     @relation("ThanhVienNhom")
  khachHang    KhachHang[]
  leads        Lead[]

  @@map("nhom_kinh_doanh")
}

// ----------------------------------------------------
// 3. NGƯỜI DÙNG & PHIÊN ĐĂNG NHẬP
// ----------------------------------------------------

enum TrangThaiNguoiDung {
  HOAT_DONG
  DA_KHOA
  CHO_KICH_HOAT
}

model NguoiDung {
  id                  String             @id @default(uuid())
  email               String             @unique @map("email")
  matKhauHash         String             @map("mat_khau_hash")
  hoTen               String             @map("ho_ten")
  soDienThoai         String?            @map("so_dien_thoai")
  chuKyEmail          String?            @map("chu_ky_email")
  avatarUrl           String?            @map("avatar_url")
  trangThai           TrangThaiNguoiDung @default(HOAT_DONG) @map("trang_thai")
  soLanDangNhapSai    Int                @default(0) @map("so_lan_dang_nhap_sai")
  khoaDenKhi          DateTime?          @map("khoa_den_khi")
  nhomKinhDoanhId     String?            @map("nhom_kinh_doanh_id")
  lanDangNhapCuoi     DateTime?          @map("lan_dang_nhap_cuoi")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  nhomKinhDoanh       NhomKinhDoanh?     @relation("ThanhVienNhom", fields: [nhomKinhDoanhId], references: [id], onDelete: SetNull)
  truongNhomTai       NhomKinhDoanh[]    @relation("TruongNhom")
  vaiTro              NguoiDungVaiTro[]
  phienDangNhap       PhienDangNhap[]
  datLaiMatKhau       DatLaiMatKhau[]
  nhatKyHeThong       NhatKyHeThong[]    @relation("NguoiThucHien")
  khachHangSoHuu      KhachHang[]        @relation("KhachHangNguoiSoHuu")
  leadSoHuu           Lead[]             @relation("LeadNguoiSoHuu")
  coHoiSoHuu          CoHoi[]            @relation("CoHoiNguoiSoHuu")
  hoatDongThucHien    HoatDong[]         @relation("HoatDongNguoiThucHien")
  lichSuPhanBoDuocNhan LichSuPhanBo[]    @relation("NguoiDuocPhanBo")
  lichSuPhanBoThucHien LichSuPhanBo[]    @relation("NguoiPhanBo")

  @@map("nguoi_dung")
}

model NguoiDungVaiTro {
  nguoiDungId String    @map("nguoi_dung_id")
  vaiTroId    String    @map("vai_tro_id")

  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  vaiTro      VaiTro    @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)

  @@id([nguoiDungId, vaiTroId])
  @@map("nguoi_dung_vai_tro")
}

model PhienDangNhap {
  id               String    @id @default(uuid())
  nguoiDungId      String    @map("nguoi_dung_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  hetHanLuc        DateTime  @map("het_han_luc")
  daThuHoi         Boolean   @default(false) @map("da_thu_hoi")
  createdAt        DateTime  @default(now()) @map("created_at")

  nguoiDung        NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)

  @@map("phien_dang_nhap")
}

model DatLaiMatKhau {
  id          String    @id @default(uuid())
  nguoiDungId String    @map("nguoi_dung_id")
  tokenHash   String    @map("token_hash")
  hetHanLuc   DateTime  @map("het_han_luc")
  daSuDung    Boolean   @default(false) @map("da_su_dung")
  createdAt   DateTime  @default(now()) @map("created_at")

  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)

  @@map("dat_lai_mat_khau")
}

// ----------------------------------------------------
// 4. NHẬT KÝ THAY ĐỔI DỮ LIỆU NHẠY CẢM (AUDIT LOG)
// ----------------------------------------------------

model NhatKyHeThong {
  id              String     @id @default(uuid())
  nguoiThucHienId String?    @map("nguoi_thuc_hien_id")
  loaiDoiTuong    String     @map("loai_doi_tuong") // NGUOI_DUNG, VAI_TRO, KHACH_HANG, LEAD, CO_HOI, QUY_TAC_CHAM_DIEM, QUY_TAC_PHAN_BO
  doiTuongId      String?    @map("doi_tuong_id")
  hanhDong        String     @map("hanh_dong") // TAO, SUA, XOA, KHOA, BAN_GIAO, GOP_KHACH_HANG, CHUYEN_DOI_LEAD, TIEP_NHAN_LEAD, TU_CHOI_LEAD
  giaTriTruoc     Json?      @map("gia_tri_truoc")
  giaTriSau       Json?      @map("gia_tri_sau")
  ipAddress       String?    @map("ip_address")
  userAgent       String?    @map("user_agent")
  createdAt       DateTime   @default(now()) @map("created_at")

  nguoiThucHien   NguoiDung? @relation("NguoiThucHien", fields: [nguoiThucHienId], references: [id], onDelete: SetNull)

  @@map("nhat_ky_he_thong")
}

// ----------------------------------------------------
// 5. DANH MỤC DÙNG CHUNG (CATALOGS)
// ----------------------------------------------------

model DanhMucDungChung {
  id            String   @id @default(uuid())
  loaiDanhMuc   String   @map("loai_danh_muc") // NGANH_NGHE, QUY_MO, NGUON_LEAD, LOAI_HOAT_DONG
  maMuc         String   @map("ma_muc")
  tenMuc        String   @map("ten_muc")
  thuTuHienThi  Int      @default(0) @map("thu_tu_hien_thi")
  kichHoat      Boolean  @default(true) @map("kich_hoat")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([loaiDanhMuc, maMuc])
  @@map("danh_muc_dung_chung")
}

// ----------------------------------------------------
// 6. SẢN PHẨM & BẢNG GIÁ NIÊM YẾT
// ----------------------------------------------------

enum LoaiSanPham {
  MOT_LAN
  THUE_BAO
}

enum TrangThaiSanPham {
  DANG_KINH_DOANH
  NGUNG_KINH_DOANH
}

model SanPham {
  id           String           @id @default(uuid())
  maSanPham    String           @unique @map("ma_san_pham")
  tenSanPham   String           @map("ten_san_pham")
  loaiSanPham  LoaiSanPham      @default(MOT_LAN) @map("loai_san_pham")
  donViTinh    String           @map("don_vi_tinh")
  giaNiemYet   Decimal          @map("gia_niem_yet") @db.Decimal(15, 2)
  giaSan       Decimal          @map("gia_san") @db.Decimal(15, 2) // Ngưỡng duyệt chiết khấu
  giaVon       Decimal          @map("gia_von") @db.Decimal(15, 2) // Chỉ Director / Admin xem được
  trangThai    TrangThaiSanPham @default(DANG_KINH_DOANH) @map("trang_thai")
  moTa         String?          @map("mo_ta")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("san_pham")
}

// ----------------------------------------------------
// 7. CẤU HÌNH PIPELINE, LÝ DO THẮNG/THUA, ĐỐI THỦ
// ----------------------------------------------------

model GiaiDoanPipeline {
  id                 String   @id @default(uuid())
  maGiaiDoan         String   @unique @map("ma_giai_doan")
  tenGiaiDoan        String   @map("ten_giai_doan")
  thuTu              Int      @map("thu_tu")
  xacSuatThang       Int      @default(10) @map("xac_suat_thang") // % xác suất thắng (0-100)
  dieuKienBatBuoc    String?  @map("dieu_kien_bat_buoc")
  kichHoat           Boolean  @default(true) @map("kich_hoat")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  coHoi              CoHoi[]

  @@map("giai_doan_pipeline")
}

enum LoaiLyDo {
  THANG
  THUA
}

model LyDoThangThua {
  id        String   @id @default(uuid())
  loai      LoaiLyDo @map("loai")
  noiDung   String   @map("noi_dung")
  thuTu     Int      @default(0) @map("thu_tu")
  kichHoat  Boolean  @default(true) @map("kich_hoat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ly_do_thang_thua")
}

model DoiThu {
  id        String   @id @default(uuid())
  tenDoiThu String   @unique @map("ten_doi_thu")
  diemManh  String?  @map("diem_manh")
  diemYeu   String?  @map("diem_yeu")
  moTa      String?  @map("mo_ta")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("doi_thu")
}

// ----------------------------------------------------
// 8. SPRINT 2: KHÁCH HÀNG & NGƯỜI LIÊN HỆ (EP-03)
// ----------------------------------------------------

enum TrangThaiKhachHang {
  TIEM_NANG
  DANG_GIAO_DICH
  KHACH_HANG
  NGUNG_HOP_TAC
}

enum VaiTroQuyetDinh {
  NGUOI_QUYET_DINH
  NGUOI_ANH_HUONG
  NGUOI_DUNG_CUOI
  NGUOI_CAN_TRO
}

model KhachHang {
  id             String             @id @default(uuid())
  maKhachHang    String             @unique @map("ma_khach_hang")
  tenCongTy      String             @map("ten_cong_ty")
  maSoThue       String?            @unique @map("ma_so_thue")
  nganhNghe      String?            @map("nganh_nghe")
  quyMo          String?            @map("quy_mo")
  website        String?            @map("website")
  diaChi         String?            @map("dia_chi")
  tinhThanh      String?            @map("tinh_thanh")
  quocGia        String?            @default("Vietnam") @map("quoc_gia")
  nguoiSoHuuId   String             @map("nguoi_so_huu_id")
  nhomKinhDoanhId String?           @map("nhom_kinh_doanh_id")
  trangThai      TrangThaiKhachHang @default(TIEM_NANG) @map("trang_thai")
  moTa           String?            @map("mo_ta")
  daGopVaoId     String?            @map("da_gop_vao_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  nguoiSoHuu     NguoiDung          @relation("KhachHangNguoiSoHuu", fields: [nguoiSoHuuId], references: [id], onDelete: Restrict)
  nhomKinhDoanh  NhomKinhDoanh?     @relation(fields: [nhomKinhDoanhId], references: [id], onDelete: SetNull)
  nguoiLienHe    NguoiLienHe[]
  coHoi          CoHoi[]
  hoatDong       HoatDong[]
  leadsChuyenDoi Lead[]             @relation("KhachHangChuyenDoiTuLead")

  @@index([maSoThue])
  @@index([nguoiSoHuuId])
  @@index([trangThai])
  @@index([tenCongTy])
  @@map("khach_hang")
}

model NguoiLienHe {
  id             String          @id @default(uuid())
  khachHangId    String          @map("khach_hang_id")
  hoTen          String          @map("ho_ten")
  chucDanh       String?         @map("chuc_danh")
  email          String?         @map("email")
  soDienThoai    String?         @map("so_dien_thoai")
  vaiTroQuyetDinh VaiTroQuyetDinh @default(NGUOI_DUNG_CUOI) @map("vai_tro_quyet_dinh")
  laDauMoiChinh  Boolean         @default(false) @map("la_dau_moi_chinh")
  ghiChu         String?         @map("ghi_chu")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  khachHang      KhachHang       @relation(fields: [khachHangId], references: [id], onDelete: Cascade)
  hoatDong       HoatDong[]

  @@index([khachHangId])
  @@index([email])
  @@index([soDienThoai])
  @@map("nguoi_lien_he")
}

// ----------------------------------------------------
// 9. SPRINT 2: LEAD & PHÂN BỔ (EP-04)
// ----------------------------------------------------

enum TrangThaiLead {
  MOI
  CHO_TIEP_NHAN
  DANG_CHAM_SOC
  TU_CHOI
  DA_CHUYEN_DOI
  KHONG_TIEM_NANG
}

enum PhanLoaiLead {
  NONG
  AM
  LANH
}

model Lead {
  id                  String         @id @default(uuid())
  maLead              String         @unique @map("ma_lead")
  hoTen               String         @map("ho_ten")
  email               String?        @map("email")
  soDienThoai         String?        @map("so_dien_thoai")
  congTy              String?        @map("cong_ty")
  chucDanh            String?        @map("chuc_danh")
  nhuCauQuanTam       String?        @map("nhu_cau_quan_tam")
  nguonLead           String         @map("nguon_lead") // REQUIRED: WEBSITE, EXCEL_IMPORT, EVENT, REFERRAL...
  nganhNghe           String?        @map("nganh_nghe")
  quyMo               String?        @map("quy_mo")
  khuVucId            String?        @map("khu_vuc_id")
  nguoiSoHuuId        String?        @map("nguoi_so_huu_id") // Null = Unassigned Queue
  nhomKinhDoanhId     String?        @map("nhom_kinh_doanh_id")
  trangThai           TrangThaiLead  @default(MOI) @map("trang_thai")
  phanLoai            PhanLoaiLead   @default(LANH) @map("phan_loai")
  diemTiemNang        Int            @default(0) @map("diem_tiem_nang")
  lyDoTuChoi          String?        @map("ly_do_tu_choi")
  khachHangGoiYId     String?        @map("khach_hang_goi_y_id")
  khachHangChuyenDoiId String?       @map("khach_hang_chuyen_doi_id")
  coHoiChuyenDoiId    String?        @map("co_hoi_chuyen_doi_id")
  assignedAt          DateTime?      @map("assigned_at")
  acceptedAt          DateTime?      @map("accepted_at")
  rejectedAt          DateTime?      @map("rejected_at")
  firstContactAt      DateTime?      @map("first_contact_at")
  slaDeadline         DateTime?      @map("sla_deadline")
  quaHanSla           Boolean        @default(false) @map("qua_han_sla")
  formSubmissionId    String?        @map("form_submission_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  khuVuc              KhuVuc?        @relation(fields: [khuVucId], references: [id], onDelete: SetNull)
  nguoiSoHuu          NguoiDung?     @relation("LeadNguoiSoHuu", fields: [nguoiSoHuuId], references: [id], onDelete: SetNull)
  nhomKinhDoanh       NhomKinhDoanh? @relation(fields: [nhomKinhDoanhId], references: [id], onDelete: SetNull)
  khachHangChuyenDoi  KhachHang?     @relation("KhachHangChuyenDoiTuLead", fields: [khachHangChuyenDoiId], references: [id], onDelete: SetNull)
  coHoiChuyenDoi      CoHoi?         @relation("CoHoiChuyenDoiTuLead", fields: [coHoiChuyenDoiId], references: [id], onDelete: SetNull)
  hoatDong            HoatDong[]
  lichSuPhanBo        LichSuPhanBo[]
  coHoiTao            CoHoi[]        @relation("CoHoiNguonLead")

  @@index([email])
  @@index([soDienThoai])
  @@index([nguoiSoHuuId])
  @@index([trangThai])
  @@index([phanLoai])
  @@index([createdAt])
  @@map("lead")
}

// ----------------------------------------------------
// 10. SCORING & ASSIGNMENT RULES (EP-04)
// ----------------------------------------------------

model QuyTacChamDiem {
  id         String   @id @default(uuid())
  tenQuyTac  String   @map("ten_quy_tac")
  tieuChi    String   @map("tieu_chi") // NGANH_NGHE, QUY_MO, NGUON_LEAD, MUC_DO_QUAN_TAM
  toanTu     String   @default("EQUALS") @map("toan_tu") // EQUALS, CONTAINS, IN
  giaTri     String   @map("gia_tri")
  diem       Int      @map("diem")
  thuTu      Int      @default(0) @map("thu_tu")
  kichHoat   Boolean  @default(true) @map("kich_hoat")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("quy_tac_cham_diem")
}

model CauHinhChamDiem {
  id             String   @id @default(uuid())
  nguongNong     Int      @default(50) @map("nguong_nong")
  nguongAm       Int      @default(25) @map("nguong_am")
  thoiGianSlaGio Int      @default(24) @map("thoi_gian_sla_gio")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("cau_hinh_cham_diem")
}

enum LoaiPhanBo {
  KHU_VUC
  NGANH_NGHE
  ROUND_ROBIN
}

model QuyTacPhanBo {
  id                   String         @id @default(uuid())
  tenQuyTac            String         @map("ten_quy_tac")
  thuTuUuTien          Int            @default(1) @map("thu_tu_uu_tien")
  loaiQuyTac           LoaiPhanBo     @map("loai_quy_tac")
  dieuKien             Json?          @map("dieu_kien") // { "khuVucId": "...", "nganhNghe": "..." }
  nguoiNhanId          String?        @map("nguoi_nhan_id")
  danhSachNguoiDungIds Json?          @map("danh_sach_nguoi_dung_ids") // Array of string user IDs
  chiSoHienTai         Int            @default(0) @map("chi_so_hien_tai")
  kichHoat             Boolean        @default(true) @map("kich_hoat")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  lichSuPhanBo         LichSuPhanBo[]

  @@map("quy_tac_phan_bo")
}

model LichSuPhanBo {
  id               String        @id @default(uuid())
  leadId           String        @map("lead_id")
  nguoiDuocPhanBoId String?      @map("nguoi_duoc_phan_bo_id")
  quyTacId         String?       @map("quy_tac_id")
  loaiPhanBo       String        @default("TU_DONG") @map("loai_phan_bo") // TU_DONG, THU_CONG
  lyDo             String?       @map("ly_do")
  nguoiThucHienId  String?       @map("nguoi_thuc_hien_id")
  createdAt        DateTime      @default(now()) @map("created_at")

  lead             Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  nguoiDuocPhanBo  NguoiDung?    @relation("NguoiDuocPhanBo", fields: [nguoiDuocPhanBoId], references: [id], onDelete: SetNull)
  quyTac           QuyTacPhanBo? @relation(fields: [quyTacId], references: [id], onDelete: SetNull)
  nguoiThucHien    NguoiDung?    @relation("NguoiPhanBo", fields: [nguoiThucHienId], references: [id], onDelete: SetNull)

  @@map("lich_su_phan_bo")
}

// ----------------------------------------------------
// 11. CƠ HỘI BÁN HÀNG TỐI THIỂU (CHO CONVERSION & CUSTOMER 360)
// ----------------------------------------------------

enum TrangThaiCoHoi {
  DANG_XU_LY
  DONG_THANG
  DONG_THUA
}

model CoHoi {
  id             String           @id @default(uuid())
  maCoHoi        String           @unique @map("ma_co_hoi")
  tenCoHoi       String           @map("ten_co_hoi")
  khachHangId    String           @map("khach_hang_id")
  leadId         String?          @map("lead_id")
  giaiDoanId     String           @map("giai_doan_id")
  giaTriDuKien   Decimal          @default(0) @map("gia_tri_du_kien") @db.Decimal(15, 2)
  ngayKyDuKien   DateTime?        @map("ngay_ky_du_kien")
  nguoiSoHuuId   String           @map("nguoi_so_huu_id")
  trangThai      TrangThaiCoHoi   @default(DANG_XU_LY) @map("trang_thai")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  khachHang      KhachHang        @relation(fields: [khachHangId], references: [id], onDelete: Cascade)
  leadNguon      Lead?            @relation("CoHoiNguonLead", fields: [leadId], references: [id], onDelete: SetNull)
  giaiDoan       GiaiDoanPipeline @relation(fields: [giaiDoanId], references: [id], onDelete: Restrict)
  nguoiSoHuu     NguoiDung        @relation("CoHoiNguoiSoHuu", fields: [nguoiSoHuuId], references: [id], onDelete: Restrict)
  hoatDong       HoatDong[]
  leadsChuyenDoi Lead[]           @relation("CoHoiChuyenDoiTuLead")

  @@index([khachHangId])
  @@index([nguoiSoHuuId])
  @@index([trangThai])
  @@map("co_hoi")
}

// ----------------------------------------------------
// 12. DÒNG THỜI GIAN HOẠT ĐỘNG (TIMELINE CHO 360 & LEAD)
// ----------------------------------------------------

model HoatDong {
  id             String       @id @default(uuid())
  loaiHoatDong   String       @map("loai_hoat_dong") // GOI_DIEN, HOP, EMAIL, GHI_CHU, CONVERT_LEAD, MERGE_CUSTOMER, PHAN_BO_LEAD
  tieuDe         String       @map("tieu_de")
  noiDung        String?      @map("noi_dung")
  khachHangId    String?      @map("khach_hang_id")
  nguoiLienHeId  String?      @map("nguoi_lien_he_id")
  leadId         String?      @map("lead_id")
  coHoiId        String?      @map("co_hoi_id")
  nguoiThucHienId String      @map("nguoi_thuc_hien_id")
  thoiGian       DateTime     @default(now()) @map("thoi_gian")
  createdAt      DateTime     @default(now()) @map("created_at")

  khachHang      KhachHang?   @relation(fields: [khachHangId], references: [id], onDelete: Cascade)
  nguoiLienHe    NguoiLienHe? @relation(fields: [nguoiLienHeId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  coHoi          CoHoi?       @relation(fields: [coHoiId], references: [id], onDelete: Cascade)
  nguoiThucHien  NguoiDung    @relation("HoatDongNguoiThucHien", fields: [nguoiThucHienId], references: [id], onDelete: Restrict)

  @@index([khachHangId])
  @@index([leadId])
  @@index([coHoiId])
  @@index([thoiGian])
  @@map("hoat_dong")
}

// ----------------------------------------------------
// 13. WEBSITE FORM EMBED (EP-04 S4-01)
// ----------------------------------------------------

model WebFormEmbed {
  id                String   @id @default(uuid())
  maForm            String   @unique @map("ma_form")
  tenForm           String   @map("ten_form")
  tieuDe            String?  @map("tieu_de")
  moTa              String?  @map("mo_ta")
  nguonLeadMacDinh  String   @default("WEBSITE") @map("nguon_lead_mac_dinh")
  mauButtonText     String   @default("Gửi liên hệ") @map("mau_button_text")
  mauMauChuDao      String   @default("#2563eb") @map("mau_mau_chu_dao")
  kichHoat          Boolean  @default(true) @map("kich_hoat")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("web_form_embed")
}

